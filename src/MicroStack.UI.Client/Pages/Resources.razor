@page "/"
@page "/resources"
@page "/services/{ServiceId}"
@implements IDisposable
@inject AdminApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_service?.Label ?? "Services") · MicroStack</PageTitle>
<div class="workspace-context">
    @if (ServiceId is not null)
    {
        <nav class="service-breadcrumb" aria-label="Service workspace">
            <a href="@HomeUrl">All services</a><span aria-hidden="true">/</span>
            <ServicePicker Services="@_services" Selected="@_service" SelectedChanged="SwitchService" />
        </nav>
    }
    @if (_context is not null)
    { <AccountScope Account="@_account" Region="@_context.Region" AccountChanged="SwitchAccount" /> }
</div>
@if (_error is not null)
{
    <div class="notice error" role="alert"><p>@_error</p>
        <button class="button" disabled="@_busy" @onclick="LoadAsync">Retry snapshot</button>
        @if (_missing) { <button class="button" @onclick="ClearSelection">Return to resource list</button> }
    </div>
}
@if (ServiceId is null)
{
    <section class="directory">
        <header class="directory-heading"><h1>Services</h1><p>Find a service, inspect its resources, and follow configured connections.</p></header>
        <div class="directory-tools">
            <div class="search"><input type="search" aria-label="Find services" placeholder="Find a service…" value="@Filter" @oninput="FilterServices" /></div>
            <label><input type="checkbox" checked="@(Enabled == true)" @onchange="FilterEnabled" /> Enabled services only</label>
        </div>
        @if (_busy) { <LoadingState Label="Loading service catalog…" /> }
        else if (_services.Count > 0)
        {
            <p class="directory-result-count" role="status">@DirectoryServices.Count of @_services.Count services</p>
            @if (DirectoryServices.Count == 0) { <p class="empty-list">No services match. Try a service name, identifier, or category.</p> }
            <div class="directory-grid">
                @foreach (var group in DirectoryServices.GroupBy(service => service.Category))
                {
                    <section class="directory-group"><h2>@group.Key <span class="count">@group.Count()</span></h2><ul>
                        @foreach (var service in group.OrderBy(service => service.Label, StringComparer.OrdinalIgnoreCase))
                        {
                            <li><a class="directory-service" href="@ServiceUrl(service.Id)">
                                <span class="directory-name"><img class="aws-service-icon" src="@($"icons/{service.Icon}.svg")" alt="" /><strong>@service.Label</strong></span>
                                <span class="directory-detail">@AvailabilityLabel(service)</span><span aria-hidden="true">→</span>
                            </a></li>
                        }
                    </ul></section>
                }
            </div>
        }
    </section>
}
else if (_service is not null)
{
    @if (ExplorerLocation.SafeReturn(ReturnTo) is { } returnTo) { <a class="return-link" href="@returnTo">← Return to previous inspection</a> }
    <header class="service-heading">
        <div><div class="service-title-line"><img class="aws-service-icon" src="@($"icons/{_service.Icon}.svg")" alt="" /><h1>@_service.Label</h1></div>
            <p>@_service.Name · @ScopeLabel(_service.Scope)</p></div>
        <button class="button mobile-resources" @onclick="ToggleBrowse">@(_browsing ? "Return to detail" : "Browse resources")</button>
    </header>
    @if (!string.IsNullOrEmpty(_service.Notice)) { <p class="notice">@_service.Notice</p> }
    @if (_service.Availability == "disabled")
    { <section class="state-panel"><h2>Service disabled</h2><p>This service is declared in the catalog but its handler is not enabled on this instance.</p><a class="button" href="/overview">View instance status</a></section> }
    else
    {
        <div class="resource-workspace @(_browsing ? "browsing" : "")">
            <section id="resource-index" class="resource-index" aria-label="Resources" tabindex="-1">
                <div class="index-heading"><span>@RootKindLabel</span><span class="count">@(_resources?.Items.Count ?? 0)</span></div>
                @if (_service.Kinds.Count > 1)
                {
                    <label class="sr-only" for="resource-kind">Resource kind</label>
                    <select id="resource-kind" class="kind-select" value="@_kind" @onchange="ChangeKind">
                        @foreach (var kind in _service.Kinds) { <option value="@kind.Id">@kind.Label</option> }
                    </select>
                }
                <form @onsubmit="ApplyResourceFilter" @onsubmit:preventDefault>
                    <div class="search"><input type="search" aria-label="Filter resources" placeholder="Filter resources…" @bind="_resourceFilter" /></div>
                    <button class="button" type="submit">Apply filter</button>
                </form>
                @if (_busy && _resources is null) { <LoadingState Label="Loading resources…" /> }
                @if (_resources is not null)
                {
                    <div class="resource-list">
                        @foreach (var resource in _resources.Items)
                        {
                            <a @key="resource.Key" class="resource-button @(IsRootSelected(resource.Key) ? "selected" : "")"
                               aria-current="@(IsRootSelected(resource.Key) ? "true" : null)" href="@RootUrl(resource.Key)">
                                <strong>@resource.Name</strong><small>@resource.Status</small>
                            </a>
                        }
                    </div>
                    @if (_resources.Items.Count == 0) { <p class="empty-list">No @RootKindLabel.ToLowerInvariant()@(string.IsNullOrEmpty(Filter) ? " in this scope." : " match this filter.")</p> }
                    <PageNavigation Loaded="@_resources.Items.Count" KnownTotal="@_resources.KnownTotal" NextCursor="@_resources.NextCursor" HasCursor="@(!string.IsNullOrEmpty(Cursor))" Changed="ChangeResourcePage" />
                }
                <p class="index-note">@ScopeLabel(_service.Scope). Lists are snapshots; use Refresh to see changes.</p>
            </section>
            <section class="inspector" aria-label="Selected resource">
                @if (_busy) { <LoadingState /> }
                else if (_detail is not null)
                {
                    <div class="resource-heading">
                        @if (_path.Length > 1)
                        {
                            <nav class="return-link" aria-label="Resource hierarchy">
                                @for (var index = 0; index < _path.Length - 1; index++)
                                {
                                    var ancestor = index;
                                    <a href="@AncestorUrl(ancestor)">@_path[ancestor].Id</a><span aria-hidden="true">/</span>
                                }
                            </nav>
                        }
                        <div class="resource-top"><div><h2 id="resource-title" tabindex="-1">@_detail.Resource.Name</h2>
                            <div class="resource-type"><span>@KindLabel(_detail.Resource.Key.Kind)</span><span class="tag">@(_detail.Resource.Status ?? "Retained resource")</span><span>@ScopeLabel(_detail.Resource.Scope)</span></div>
                        </div><button class="button" @onclick="LoadAsync">Refresh</button></div>
                        <div class="arn-row"><code>@(_detail.Resource.Arn ?? _detail.Resource.Key.Id)</code><CopyButton Text="@(_detail.Resource.Arn ?? _detail.Resource.Key.Id)" Label="Copy identifier" /></div>
                    </div>
                    <div class="tabs" role="tablist" aria-label="Resource inspection">
                        @foreach (var tab in Tabs)
                        {
                            <button id="@($"tab-{tab.Id}")" role="tab" aria-selected="@(ActiveTab == tab.Id ? "true" : "false")" tabindex="@(ActiveTab == tab.Id ? 0 : -1)"
                                    aria-controls="inspection-panel" @onclick="() => ChangeTab(tab.Id)">@tab.Label</button>
                        }
                    </div>
                    <div id="inspection-panel" class="tab-body" role="tabpanel" aria-labelledby="@($"tab-{ActiveTab}")">
                        @if (ActiveTab == "configuration")
                        {
                            <FieldList @key="_scopeKey" Fields="@_detail.Fields" RevealableFields="@_detail.RevealableFields" Service="@ServiceId" Account="@_account" Path="@_path" />
                            @if (_detail.Fields.Count == 0 && _detail.RevealableFields.Count == 0) { <p class="empty-list">No additional configuration is retained for this resource.</p> }
                        }
                        else if (ActiveTab == "connections")
                        {
                            <p class="notice">Explicit configured relationships only. A configured connection does not establish successful delivery.</p>
                            @if (_connections is { Items.Count: > 0 })
                            {
                                <div class="connection-list">
                                    @foreach (var connection in _connections.Items)
                                    {
                                        <div class="connection"><div><strong>@connection.Label</strong><small>@connection.Relation</small>
                                            <small><span class="tag">@connection.State</span></small>
                                            @if (connection.ExternalUri is not null) { <code>@connection.ExternalUri</code> }
                                        </div>
                                            @if (CanFollow(connection)) { <a class="button" href="@ConnectionUrl(connection)">Inspect destination →</a> }
                                        </div>
                                    }
                                </div>
                                <PageNavigation Loaded="@_connections.Items.Count" KnownTotal="@_connections.KnownTotal" NextCursor="@_connections.NextCursor" HasCursor="@(!string.IsNullOrEmpty(ConnectionCursor))" Changed="ChangeConnectionPage" />
                            }
                            else { <p class="empty-list">No configured connections are retained for this resource.</p> }
                        }
                        else if (ActiveTab == "activity")
                        { <RequestActivity @key="@($"{ServiceId}:{_account}")" Service="@ServiceId" Account="@_account" /> }
                        else
                        {
                            @if (ServiceId == "sqs") { <p class="notice">Read-only queue snapshot. Inspection does not receive messages, change visibility, or advance consumers.</p> }
                            @if (ServiceId == "dynamodb") { <p class="notice">Items retain DynamoDB attribute types (S, N, M, L, and other modeled types). Browsing does not execute a query or alter items.</p> }
                            @if (_detail.HasChildren)
                            {
                                <div class="content-tools">
                                    <form @onsubmit="ApplyChildFilter" @onsubmit:preventDefault class="toolbar">
                                        @if (ChildKinds.Count > 1)
                                        {
                                            <label for="child-kind">Collection</label><select id="child-kind" value="@ChildKind" @onchange="ChangeChildKind">
                                                <option value="">All collections</option>
                                                @foreach (var kind in ChildKinds) { <option value="@kind.Id">@kind.Label</option> }
                                            </select>
                                        }
                                        <div class="search"><input type="search" aria-label="Filter stored entries" placeholder="Filter entries…" @bind="_childFilter" /></div>
                                        @if (ServiceId == "s3") { <label for="object-prefix">Prefix</label><input id="object-prefix" type="text" placeholder="Path prefix" @bind="_prefixFilter" /> }
                                        <button class="button" type="submit">Apply</button>
                                    </form>
                                </div>
                                <div class="data-split">
                                    <section class="records" aria-label="@ChildrenLabel">
                                        <div class="list-heading"><span>@ChildrenLabel</span><span>@(_children?.Items.Count ?? 0) loaded</span></div>
                                        @if (_children is not null)
                                        {
                                            @foreach (var group in _children.Items.GroupBy(child => child.Key.Kind))
                                            {
                                                @if (ChildKinds.Count > 1) { <div class="list-heading">@KindLabel(group.Key)</div> }
                                                @foreach (var child in group)
                                                {
                                                    <a @key="child.Key" class="record-button @(IsChildSelected(child.Key) ? "selected" : "")"
                                                       aria-current="@(IsChildSelected(child.Key) ? "true" : null)" href="@ChildUrl(child.Key)">
                                                        <div class="record-title">@child.Name</div><div class="record-meta"><span>@KindLabel(child.Key.Kind)</span><span>@child.Status</span></div>
                                                    </a>
                                                }
                                            }
                                            @if (_children.Items.Count == 0) { <p class="empty-list">No stored entries match this collection and filter.</p> }
                                        }
                                    </section>
                                    <section class="payload" aria-label="Selected entry">
                                        @if (_childError is not null) { <p class="notice error" role="alert">@_childError</p> }
                                        @if (_selectedDetail is not null)
                                        {
                                            <div class="payload-head"><strong>@_selectedDetail.Resource.Name</strong>
                                                @if (_selectedDetail.HasChildren) { <a class="button" href="@OpenChildUrl">Browse @KindLabel(_selectedDetail.Resource.Key.Kind) →</a> }
                                            </div>
                                            <div class="payload-body">
                                                <FieldList @key="@(_scopeKey + "-selected")" Fields="@_selectedDetail.Fields" RevealableFields="@_selectedDetail.RevealableFields" Service="@ServiceId" Account="@_account" Path="@SelectedPath" />
                                                @if (_selectedDetail.HasConnections) { <a class="button" href="@SelectedConnectionsUrl">View configured connections</a> }
                                            </div>
                                            @if (_selectedDetail.HasContent) { <ContentPreview Content="@_selectedContent" /> }
                                            else if (!_selectedDetail.HasChildren && _selectedDetail.Fields.Count == 0) { <p class="empty-list">This entry retains metadata only.</p> }
                                        }
                                        else if (_childError is null) { <p class="empty-list">Select an entry to inspect its content and metadata.</p> }
                                    </section>
                                </div>
                                @if (_children is not null)
                                { <PageNavigation Loaded="@_children.Items.Count" KnownTotal="@_children.KnownTotal" NextCursor="@_children.NextCursor" HasCursor="@(!string.IsNullOrEmpty(ChildCursor))" Changed="ChangeChildPage" /> }
                            }
                            @if (_detail.HasContent) { <ContentPreview Content="@_content" /> }
                            @if (!_detail.HasChildren && !_detail.HasContent)
                            { <p class="notice">This resource retains configuration, not a browsable content collection. Inspect the Configuration tab for its modeled fields.</p> }
                        }
                    </div>
                }
                else if (!_missing)
                {
                    <div class="state-panel"><h2>@(_service.Kinds.Count == 0 ? "No retained resources" : "Choose a resource")</h2>
                        <p>@(_service.Kinds.Count == 0 ? "This service does not retain a resource collection. Its scope and request activity remain available." : "Select a resource from the index, or refresh after creating one through its AWS API.")</p>
                        <button class="button" @onclick="LoadAsync">Refresh</button>
                    </div>
                    @if (_service.Kinds.Count == 0) { <div class="tab-body"><RequestActivity Service="@ServiceId" Account="@_account" /></div> }
                }
            </section>
        </div>
    }
    <footer class="workspace-footer"><span>Read-only inspection · content previews up to 1 MiB</span>
        @if (_captured is { } captured) { <span>Snapshot · @ExplorerLocation.Utc(captured)</span> }
    </footer>
}
else if (_busy) { <LoadingState /> }
