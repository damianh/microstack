@page "/requests"
@implements IAsyncDisposable
@inject MicroStackApiService Api

<PageTitle>Request Log</PageTitle>

<h1>Request Log</h1>

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-primary btn-sm" @onclick="LoadAsync">Refresh</button>
    <button class="btn btn-outline-danger btn-sm" @onclick="ClearAsync">Clear log</button>
    <button class="btn btn-outline-secondary btn-sm" @onclick="TogglePause">@(_paused ? "Resume" : "Pause")</button>
    <select class="form-select form-select-sm w-auto" value="@_rowLimit" @onchange="OnLimitChanged">
        <option value="100">100 rows</option>
        <option value="500">500 rows</option>
        <option value="1000">1000 rows</option>
    </select>
</div>

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th>Timestamp</th>
            <th>Service</th>
            <th>Action</th>
            <th>Account</th>
            <th>Status</th>
            <th>Duration</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in _entries)
        {
            <tr>
                <td>@entry.Timestamp.ToLocalTime().ToString("u")</td>
                <td>@entry.Service</td>
                <td>@entry.Action</td>
                <td>@entry.AccountId</td>
                <td><span class="badge @StatusClass(entry.StatusCode)">@entry.StatusCode</span></td>
                <td>@entry.DurationMs ms</td>
            </tr>
        }
    </tbody>
</table>

@if (_entries.Count == 0)
{
    <p class="text-muted">No requests yet.</p>
}

@code {
    private readonly CancellationTokenSource _pollCts = new();
    private IReadOnlyList<RequestLogEntry> _entries = [];
    private bool _paused;
    private int _rowLimit = 100;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        while (await timer.WaitForNextTickAsync(_pollCts.Token))
        {
            if (_paused)
                continue;

            await InvokeAsync(LoadAsync);
        }
    }

    private async Task LoadAsync()
    {
        _entries = await Api.GetRequestsAsync(_rowLimit);
    }

    private async Task ClearAsync()
    {
        await Api.DeleteRequestsAsync();
        await LoadAsync();
    }

    private void TogglePause()
    {
        _paused = !_paused;
    }

    private async Task OnLimitChanged(ChangeEventArgs args)
    {
        _rowLimit = int.TryParse(args.Value?.ToString(), out var parsed) ? parsed : 100;
        await LoadAsync();
    }

    private static string StatusClass(int statusCode) => statusCode switch
    {
        >= 200 and < 300 => "text-bg-success",
        >= 300 and < 400 => "text-bg-warning",
        _ => "text-bg-danger",
    };

    public ValueTask DisposeAsync()
    {
        _pollCts.Cancel();
        _pollCts.Dispose();
        return ValueTask.CompletedTask;
    }
}
