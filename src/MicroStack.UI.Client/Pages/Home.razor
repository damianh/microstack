@page "/"
@inject MicroStackApiService Api

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

@if (_isLoading)
{
    <p>Loading...</p>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted">Services</h6>
                    <div class="fs-4">@(_health?.Services.Count ?? 0)</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted">Edition</h6>
                    <div class="fs-6">@(_health?.Edition ?? "-")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted">Version</h6>
                    <div class="fs-6">@(_health?.Version ?? "-")</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted">Known Resources</h6>
                    <div class="fs-4">@_resourceCount</div>
                </div>
            </div>
        </div>
    </div>

    <h3>Service status</h3>
    <div class="row g-3 mb-4">
        @if (_health?.Services is { Count: > 0 } services)
        {
            foreach (var service in services.OrderBy(kv => kv.Key, StringComparer.Ordinal))
            {
                <div class="col-md-3">
                    <div class="card">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <span>@service.Key</span>
                            <span class="badge text-bg-success">@service.Value</span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <h3>Resource summary</h3>
    <div class="row g-3 mb-4">
        @foreach (var summary in _resources.OrderBy(r => r.Service, StringComparer.Ordinal))
        {
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <h6 class="text-muted">@summary.Service</h6>
                        <div class="fs-4">@summary.Count</div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (_confirmReset)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center">
            <span>This will clear all in-memory state.</span>
            <div class="d-flex gap-2">
                <button class="btn btn-danger btn-sm" @onclick="ResetStateAsync">Confirm reset</button>
                <button class="btn btn-secondary btn-sm" @onclick="() => _confirmReset = false">Cancel</button>
            </div>
        </div>
    }
    else
    {
        <button class="btn btn-outline-danger" @onclick="() => _confirmReset = true">Reset all state</button>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <p class="mt-3 text-muted">@_message</p>
    }
}

@code {
    private bool _isLoading = true;
    private bool _confirmReset;
    private string? _message;
    private HealthResponse? _health;
    private IReadOnlyList<ResourceSummary> _resources = [];
    private int _resourceCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _health = await Api.GetHealthAsync();
        _resources = await Api.GetResourcesAsync();
        _resourceCount = _resources.Sum(r => r.Count);
        _isLoading = false;
    }

    private async Task ResetStateAsync()
    {
        await Api.ResetAsync();
        _confirmReset = false;
        _message = "State reset completed.";
        await LoadAsync();
    }
}
