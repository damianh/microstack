<div class="pagination">
    <span>@Loaded loaded@(KnownTotal is { } total ? $" · {total:N0} total" : "")</span>
    <div>
        @if (HasCursor) { <button class="button" @onclick="() => Changed.InvokeAsync(null)">Restart</button> }
        <button class="button" disabled="@string.IsNullOrEmpty(NextCursor)" @onclick="() => Changed.InvokeAsync(NextCursor)">Next page</button>
    </div>
</div>
@code {
    [Parameter] public int Loaded { get; set; }
    [Parameter] public long? KnownTotal { get; set; }
    [Parameter] public string? NextCursor { get; set; }
    [Parameter] public bool HasCursor { get; set; }
    [Parameter] public EventCallback<string?> Changed { get; set; }
}
