<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>MicroStack</AssemblyName>
    <RootNamespace>MicroStack</RootNamespace>
  </PropertyGroup>

  <!-- Native AOT publishing -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>

  <!-- OCI container image publishing via 'dotnet publish /t:PublishContainer' -->
  <!-- The image includes the native API and the self-contained Blazor host. -->
  <PropertyGroup>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/runtime-deps:10.0-alpine</ContainerBaseImage>
    <ContainerRepository>microstack</ContainerRepository>
    <ContainerImageTags>$(MinVerVersion);latest</ContainerImageTags>
    <!-- Multi-arch: amd64 + arm64 -->
    <ContainerRuntimeIdentifiers>linux-musl-x64;linux-musl-arm64</ContainerRuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ContainerPort Include="4566" Type="tcp" />
    <ContainerPort Include="4567" Type="tcp" />
    <ContainerEnvironmentVariable Include="ASPNETCORE_HTTP_PORTS" Value="4566" />
    <ContainerEnvironmentVariable Include="MICROSTACK_UI_PORT" Value="4567" />
    <ContainerEnvironmentVariable Include="DOTNET_SYSTEM_GLOBALIZATION_INVARIANT" Value="1" />
    <ContainerAppCommand Include="/bin/sh" Condition="'$(PublishAdminUi)' != 'false'" />
    <ContainerAppCommandArgs Include="/app/entrypoint.sh" Condition="'$(PublishAdminUi)' != 'false'" />
  </ItemGroup>

  <Target Name="PublishAdminUi" AfterTargets="Publish" Condition="'$(PublishAdminUi)' != 'false'">
    <PropertyGroup>
      <_AdminUiPublishDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)', 'ui'))</_AdminUiPublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="..\MicroStack.UI\MicroStack.UI.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishAot=false;PublishDir=$(_AdminUiPublishDirectory)"
             RemoveProperties="PublishProfile;ContainerRuntimeIdentifiers;ContainerArchiveOutputPath;OutputPath;IntermediateOutputPath" />
    <Copy SourceFiles="..\..\entrypoint.sh" DestinationFolder="$(PublishDir)" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="MicroStack.Tests" />
    <ProjectReference Include="..\MicroStack.Admin.Contracts\MicroStack.Admin.Contracts.csproj" />
  </ItemGroup>

</Project>
